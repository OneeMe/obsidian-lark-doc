{
	"name": "obsidian-lark",
	"version": "1.0.0",
	"description": "Bridge your Obsidian vault with Lark and Feishu documents.",
	"main": "main.js",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/OneeMe/obsidian-lark.git"
	},
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "node --test tests/*.test.mjs",
		"test:coverage": "node tests/run-coverage.mjs",
		"release:prepare": "node scripts/prepare-release.mjs",
		"release:validate": "node scripts/validate-release.mjs",
		"release:community-entry": "node scripts/community-entry.mjs",
		"release:notes": "node scripts/changelog-section.mjs",
		"version": "node version-bump.mjs && git add package.json package-lock.json manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [
		"obsidian",
		"plugin",
		"feishu",
		"lark"
	],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "9.30.1",
		"@types/node": "^16.11.6",
		"c8": "^11.0.0",
		"esbuild": "0.25.5",
		"eslint-plugin-obsidianmd": "0.1.9",
		"globals": "14.0.0",
		"jiti": "2.6.1",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.35.1"
	},
	"dependencies": {
		"obsidian": "latest"
	}
}
